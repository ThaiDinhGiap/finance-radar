DB_PASSWORD=radar_local_only
RADAR_USER_AGENT=FinanceRadar/1.0 (+https://your-domain.example/contact)

# AI chat: external file containing OPENROUTER_API_KEY; never put the key here.
OPENROUTER_ENV_FILE="${HOME}/.config/OpenRouter key/.env"
RADAR_AI_MODEL=inclusionai/ling-3.0-flash-vl:free

# Cosine threshold for semantic retrieval; calibrate with your evaluation questions.
RADAR_RAG_MIN_SIMILARITY=0.3
